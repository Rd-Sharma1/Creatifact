{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "creatifact",
    "version": "1.0.0",
    "description": "create developer artifacts",
    "license": "ISC",
    "author": "",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "start": "node dist/index",
        "build": "tsc -p .",
        "test": "node --import tsx --input-type=module -e \"await Promise.all([import('./src/app/modules/auth/security.test.ts'), import('./src/app/modules/artifact-request/scope/ScopeResolver.test.ts'), import('./src/app/modules/artifact-request/schema.test.ts'), import('./src/app/modules/artifact-request/intent/ArtifactIntentResolver.test.ts'), import('./src/app/modules/artifact-request/retrieval/WorkHistoryRetriever.test.ts'), import('./src/app/modules/artifact-generation/ArtifactGeneration.test.ts'), import('./src/app/modules/artifact-generation/ArtifactGenerationWorkflow.test.ts'), import('./src/app/modules/artifact-generation/EvidenceBuilder.test.ts'), import('./src/app/modules/artifact-generation/CandidateValidator.test.ts'), import('./src/app/modules/artifact-generation/OpenRouterCandidateGenerator.test.ts'), import('./src/app/modules/llm/OpenRouterClient.test.ts'), import('./scripts/db-preflight.test.ts')])\"",
        "dev": "tsc-watch --onSuccess \"node dist/index\"",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:preflight": "node --import tsx scripts/db-preflight.ts",
        "db:test:check": "node --import tsx scripts/test-db-guard.ts",
        "test-db-push": "node dist/app/modules/changeset/index"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "express": "^5.2.1",
        "inngest": "^4.19.0",
        "octokit": "^5.0.5",
        "pg": "^8.23.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.2.0",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.10",
        "tsc-watch": "^7.2.1",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    }
}
